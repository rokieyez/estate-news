<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ post.title }}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 0 16px 80px;
    background: #f5f6f8; color: #1a1a1a;
    font-family: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    line-height: 1.8; font-size: 16px;
  }
  .bar {
    position: sticky; top: 0; z-index: 10;
    margin: 0 -16px 20px; padding: 12px 16px;
    background: #03c75a; color: #fff;
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  }
  .bar strong { margin-right: auto; font-size: 15px; }
  .bar button {
    border: 0; border-radius: 6px; padding: 8px 14px;
    background: rgba(255,255,255,.18); color: #fff;
    font-size: 14px; font-weight: 600; cursor: pointer;
    font-family: inherit;
  }
  .bar button:hover { background: rgba(255,255,255,.3); }
  .bar button.done { background: #fff; color: #03c75a; }
  .wrap { max-width: 720px; margin: 0 auto; }
  .card { background: #fff; border-radius: 10px; padding: 32px 28px; }
  .title { font-size: 24px; font-weight: 700; line-height: 1.45; margin: 0 0 6px; }
  .meta { color: #888; font-size: 13px; margin-bottom: 28px; }
  #post h2 {
    font-size: 20px; font-weight: 700; margin: 40px 0 14px;
    padding-bottom: 8px; border-bottom: 2px solid #03c75a;
  }
  #post h3 { font-size: 17px; font-weight: 700; margin: 28px 0 10px; }
  #post p { margin: 0 0 18px; }
  #post ul, #post ol { margin: 0 0 18px; padding-left: 22px; }
  #post li { margin-bottom: 8px; }
  #post table { border-collapse: collapse; width: 100%; margin: 0 0 20px; font-size: 15px; }
  #post th, #post td { border: 1px solid #ddd; padding: 9px 12px; text-align: left; }
  #post th { background: #f2f4f6; font-weight: 700; }
  #post blockquote {
    margin: 0 0 18px; padding: 12px 16px;
    background: #f7f8fa; border-left: 4px solid #03c75a; color: #444;
  }
  #post a { color: #0068c3; }
  .imgslot {
    margin: 0 0 20px; padding: 22px 16px; text-align: center;
    border: 2px dashed #c9cdd2; border-radius: 8px;
    background: #fafbfc; color: #6b7178; font-size: 14px;
  }
  .tags { margin: 36px 0 0; color: #0068c3; font-size: 15px; word-break: keep-all; }
  .hint {
    max-width: 720px; margin: 20px auto 0; padding: 16px 18px;
    background: #fff8e1; border: 1px solid #ffe082; border-radius: 8px;
    font-size: 14px; line-height: 1.75; color: #5f4b16;
  }
  .hint ol { margin: 8px 0 0; padding-left: 20px; }
</style>
</head>
<body>

<div class="bar">
  <strong>네이버 블로그 붙여넣기</strong>
  <button type="button" data-copy="title">제목 복사</button>
  <button type="button" data-copy="post">본문 복사</button>
  <button type="button" data-copy="tags">태그 복사</button>
</div>

<div class="wrap">
  <div class="card">
    <h1 class="title" id="title">{{ post.title }}</h1>
    <div class="meta">{{ date }} · {{ category }}</div>

    <div id="post">
{{ body_html }}
{% if hashtags %}
      <p class="tags" id="tags">{{ hashtags }}</p>
{% endif %}
    </div>
  </div>

  <div class="hint">
    <strong>쓰는 법</strong>
    <ol>
      <li><b>제목 복사</b> → 네이버 블로그 글쓰기의 제목 칸에 붙여넣기</li>
      <li><b>본문 복사</b> → 본문 칸에 붙여넣기. 소제목·표·굵게가 그대로 살아납니다.</li>
      <li>점선 상자(<span style="color:#6b7178">📷 이미지</span>) 자리에 사진을 넣고 상자는 지웁니다.</li>
      <li>맨 아래 해시태그는 그대로 두면 네이버가 태그로 인식합니다.</li>
    </ol>
    이 안내문은 복사에 포함되지 않습니다.
  </div>
</div>

<script>
// 버튼이 지정한 영역만 클립보드에 담는다. 안내문과 상단 바는 복사되지 않는다.
document.querySelectorAll("[data-copy]").forEach(function (btn) {
  btn.addEventListener("click", function () {
    var node = document.getElementById(btn.dataset.copy);
    if (!node) return;

    // 서식을 살리려면 선택 영역을 만들어 복사해야 한다.
    // execCommand 는 구식이지만 file:// 에서 서식 복사가 확실하게 되는 유일한 방법이다.
    var range = document.createRange();
    range.selectNodeContents(node);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);

    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
    sel.removeAllRanges();

    if (!ok && navigator.clipboard) {
      navigator.clipboard.writeText(node.innerText).then(flash, function () {
        alert("복사에 실패했습니다. 직접 드래그해서 복사해 주세요.");
      });
      return;
    }
    flash();

    function flash() {
      var original = btn.textContent;
      btn.textContent = "복사됨 ✓";
      btn.classList.add("done");
      setTimeout(function () {
        btn.textContent = original;
        btn.classList.remove("done");
      }, 1400);
    }
  });
});
</script>
</body>
</html>
