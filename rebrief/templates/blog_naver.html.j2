<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ post.title }}</title>
<style>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 0 16px 80px;
    background: #f5f6f8; color: #1a1a1a;
    font-family: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    line-height: 1.8; font-size: 16px;
  }
  .bar {
    position: sticky; top: 0; z-index: 10;
    margin: 0 -16px 20px; padding: 12px 16px;
    background: #03c75a; color: #fff;
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  }
  .bar strong { margin-right: auto; font-size: 15px; }
  .bar button {
    border: 0; border-radius: 6px; padding: 8px 14px;
    background: rgba(255,255,255,.18); color: #fff;
    font-size: 14px; font-weight: 600; cursor: pointer;
    font-family: inherit;
  }
  .bar button:hover { background: rgba(255,255,255,.3); }
  .bar button.done { background: #fff; color: #03c75a; }
  .bar a.write {
    border-radius: 6px; padding: 8px 14px; background: #fff; color: #03c75a;
    font-size: 14px; font-weight: 700; text-decoration: none;
  }
  @media (max-width: 560px) {
    /* 휴대폰에서는 제목 줄을 따로 두고 버튼을 꽉 채운다 */
    .bar { gap: 6px; }
    .bar strong { flex-basis: 100%; margin: 0 0 4px; font-size: 14px; }
    .bar button, .bar a.write { flex: 1 1 0; text-align: center; padding: 10px 6px; font-size: 13px; }
    .card { padding: 22px 16px; }
    .title { font-size: 21px; }
  }
  .wrap { max-width: 720px; margin: 0 auto; }
  .card { background: #fff; border-radius: 10px; padding: 32px 28px; }
  .title { font-size: 24px; font-weight: 700; line-height: 1.45; margin: 0 0 6px; }
  .meta { color: #888; font-size: 13px; margin-bottom: 28px; }
  /* 구분선은 **꼭지와 꼭지 사이**에 둔다 (제목 위).
     예전에는 제목 아래에 선을 그었는데, 붙여넣고 보면 앞 꼭지의 마지막 문장과 다음
     제목이 붙어 버리고, 정작 제목과 그 본문 사이가 선으로 갈라져 서로 남처럼 보였다.
     이제 앞 꼭지 끝 → 넉넉한 여백 → 선 → 제목 → 본문 순서로 읽힌다.
     이 서식은 '본문 복사' 때 그대로 따라가므로 네이버에 붙여넣어도 같게 보인다. */
  #post h2 {
    font-size: 20px; font-weight: 700; margin: 56px 0 16px;
    padding-top: 26px; border-top: 2px solid #03c75a;
  }
  /* 첫 제목 앞에는 나눌 앞 꼭지가 없으므로 선을 긋지 않는다.
     :first-child 가 아니라 :first-of-type 인 이유 — 제목 앞에 요약·목차·용어 상자가
     먼저 오므로 첫 h2 는 결코 #post 의 첫 자식이 아니다. 예전 규칙은 한 번도
     맞은 적이 없었다. */
  #post h2:first-of-type { margin-top: 8px; padding-top: 0; border-top: none; }
  #post h3 { font-size: 17px; font-weight: 700; margin: 38px 0 10px; }
  #post p { margin: 0 0 18px; }
  #post ul, #post ol { margin: 0 0 18px; padding-left: 22px; }
  #post li { margin-bottom: 8px; }
  #post table { border-collapse: collapse; width: 100%; margin: 0 0 20px; font-size: 15px; }
  #post th, #post td { border: 1px solid #ddd; padding: 9px 12px; text-align: left; }
  #post th { background: #f2f4f6; font-weight: 700; }
  #post blockquote {
    margin: 0 0 18px; padding: 12px 16px;
    background: #f7f8fa; border-left: 4px solid #03c75a; color: #444;
  }
  #post a { color: #0068c3; }
  .imgslot {
    margin: 0 0 20px; padding: 22px 16px; text-align: center;
    border: 2px dashed #c9cdd2; border-radius: 8px;
    background: #fafbfc; color: #6b7178; font-size: 14px;
  }
  .imgslot.has-file { border-color: #03c75a; background: #f2fbf5; color: #2c6e45; }
  .photo-links { margin: -12px 0 20px; font-size: 13px; color: #6b7178; text-align: center; }
  .photo-links a { color: #0068c3; }
  .imgslot small { display: block; margin-top: 6px; font-size: 13px; color: #5a6a60; }
  .preview { display: block; max-width: 100%; height: auto; margin: -8px 0 22px; border: 1px solid #e4e7ea; border-radius: 8px; }
  .tags { margin: 36px 0 0; color: #0068c3; font-size: 15px; word-break: keep-all; }
  .hint {
    max-width: 720px; margin: 20px auto 0; padding: 16px 18px;
    background: #fff8e1; border: 1px solid #ffe082; border-radius: 8px;
    font-size: 14px; line-height: 1.75; color: #5f4b16;
  }
  .hint ol { margin: 8px 0 0; padding-left: 20px; }
</style>
</head>
<body>

<div class="bar">
  <strong>네이버 블로그 붙여넣기</strong>
  <button type="button" data-copy="title">제목 복사</button>
  <button type="button" data-copy="post">본문 복사</button>
  <button type="button" data-copy="tags">태그 복사</button>
  <a class="write" href="{{ write_url }}" target="_blank" rel="noopener">글쓰기 열기</a>
</div>

<div class="wrap">
  <div class="card">
    <h1 class="title" id="title">{{ post.title }}</h1>
    <div class="meta">{{ date }} · {{ category }}</div>

    <div id="post">
{{ body_html|safe }}
{% if hashtags %}
      <p class="tags" id="tags">{{ hashtags }}</p>
{% endif %}
    </div>
  </div>

  <div class="hint">
    <strong>쓰는 법</strong>
    <ol>
      <li><b>글쓰기 열기</b> → 네이버 블로그 글쓰기 화면이 새 탭에서 열립니다</li>
      <li><b>제목 복사</b> → 제목 칸에 붙여넣기</li>
      <li><b>본문 복사</b> → 본문 칸에 붙여넣기. 소제목·표·굵게가 그대로 살아납니다.</li>
      <li>점선 상자(<span style="color:#6b7178">📷 이미지</span>) 자리에 사진을 넣고 상자는 지웁니다.
        <b>초록 상자</b>는 자동 생성된 그림이 있는 자리입니다 — 상자에 적힌 파일명을 같은 폴더에서 찾아 올리세요.
        미리보기 그림은 복사에 포함되지 않습니다.</li>
      <li>맨 위 <b>오늘의 숫자</b> 표는 브리핑의 핵심 수치입니다. <span style="background-color:#fff59d"><b>굵은 형광펜</b></span>은 그 수치가 본문에 처음 나온 자리,
        <span style="background-color:#fff59d">형광펜</span>은 세 번 이상 되풀이된 수치의 첫 자리, <u>밑줄</u>은 같은 수치가 다시 나온 자리입니다. 붙여넣으면 그대로 따라가고, 마음에 안 들면 에디터에서 지우세요.</li>
      <li>맨 아래 해시태그는 그대로 두면 네이버가 태그로 인식합니다.</li>
    </ol>
    이 안내문은 복사에 포함되지 않습니다.
  </div>
</div>

<script>
// 버튼이 지정한 영역만 클립보드에 담는다. 안내문과 상단 바는 복사되지 않는다.
document.querySelectorAll("[data-copy]").forEach(function (btn) {
  btn.addEventListener("click", function () {
    var node = document.getElementById(btn.dataset.copy);
    if (!node) return;

    // 미리보기 이미지(.nocopy)는 빼고 복사한다. 상대 경로 <img> 가 붙여넣기에 섞이면
    // 네이버 에디터에 깨진 그림이 생긴다. 복사용 사본을 만들어 그것만 선택한다.
    var copyNode = node;
    var clone = null;
    if (node.querySelector(".nocopy")) {
      clone = node.cloneNode(true);
      clone.querySelectorAll(".nocopy").forEach(function (el) { el.remove(); });
      clone.style.position = "fixed"; clone.style.left = "-9999px"; clone.style.top = "0";
      document.body.appendChild(clone);
      copyNode = clone;
    }

    // 서식을 살리려면 선택 영역을 만들어 복사해야 한다.
    // execCommand 는 구식이지만 file:// 에서 서식 복사가 확실하게 되는 유일한 방법이다.
    var range = document.createRange();
    range.selectNodeContents(copyNode);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);

    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
    sel.removeAllRanges();
    var plainText = copyNode.innerText;
    if (clone) clone.remove();

    if (!ok && navigator.clipboard) {
      navigator.clipboard.writeText(plainText).then(flash, function () {
        alert("복사에 실패했습니다. 직접 드래그해서 복사해 주세요.");
      });
      return;
    }
    flash();

    function flash() {
      var original = btn.textContent;
      btn.textContent = "복사됨 ✓";
      btn.classList.add("done");
      setTimeout(function () {
        btn.textContent = original;
        btn.classList.remove("done");
      }, 1400);
    }
  });
});
</script>
</body>
</html>
